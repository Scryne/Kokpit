{
  "name": "kokpit",
  "version": "0.1.0",
  "private": true,
  "description": "Scryne'in projelerini tek ekranda goren ve karttan claude oturumu acan yerel kokpit",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "start": "node scripts/start.cjs",
    "kokpit": "node scripts/uretim.cjs",
    "dev:vite": "vite",
    "build": "tsc -b && vite build",
    "electron": "electron .",
    "typecheck": "tsc -b --noEmit",
    "test:pty": "node scripts/test-pty.cjs",
    "test:ui": "node scripts/test-ui.cjs",
    "kisayol": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/kisayol.ps1",
    "design:lint": "npx -p @google/design.md designmd lint DESIGN.md"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "lucide-react": "^1.44.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "electron@44.3.0": true,
    "node-pty@1.1.0": true
  }
}
